[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1"]
[ext_resource type="AudioStream" path="res://audio/music/menu_theme.mp3" id="2"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="MusicPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2")
volume_db = -6.0
autoplay = true

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 18
alignment = 1

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
horizontal_alignment = 1
theme_override_font_sizes/font_size = 40
text = "Household Course"

[node name="Subtitle" type="Label" parent="Center/VBox"]
layout_mode = 2
horizontal_alignment = 1
text = "A tiny obstacle course, hit with whatever's in the drawer."

[node name="PlayerCountRow" type="HBoxContainer" parent="Center/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[node name="Label" type="Label" parent="Center/VBox/PlayerCountRow"]
layout_mode = 2
text = "Players:"

[node name="MinusButton" type="Button" parent="Center/VBox/PlayerCountRow"]
layout_mode = 2
text = "-"

[node name="CountLabel" type="Label" parent="Center/VBox/PlayerCountRow"]
layout_mode = 2
custom_minimum_size = Vector2(24, 0)
horizontal_alignment = 1
text = "1"

[node name="PlusButton" type="Button" parent="Center/VBox/PlayerCountRow"]
layout_mode = 2
text = "+"

[node name="StartButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "Start Game"

[node name="QuitButton" type="Button" parent="Center/VBox"]
layout_mode = 2
text = "Quit"

[connection signal="pressed" from="Center/VBox/PlayerCountRow/MinusButton" to="." method="_on_minus_pressed"]
[connection signal="pressed" from="Center/VBox/PlayerCountRow/PlusButton" to="." method="_on_plus_pressed"]
[connection signal="pressed" from="Center/VBox/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Center/VBox/QuitButton" to="." method="_on_quit_pressed"]
